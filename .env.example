# Copy to .env and fill in. Never commit the real .env file.

# Must be https: the password is sent to it (plain http is only accepted for localhost, e.g. a mock portal).
URJA_PORTAL_BASE_URL=https://urja-ops.flockenergy.tech

# Service-account credentials: use the ones from the assignment email.
# Left blank on purpose: the app refuses to start without them.
URJA_PORTAL_EMAIL=
URJA_PORTAL_PASSWORD=

URJA_REQUEST_TIMEOUT_SECONDS=10

# IANA zone the portal's timestamps ("23/06/2026 23:30") are read in before they become UTC.
# The portal states none: Asia/Kolkata is an assumption (the network is in Jaipur). See PROTOCOL.md.
URJA_PORTAL_TIMEZONE=Asia/Kolkata

# Politeness and robustness towards the portal
URJA_MAX_RETRIES=2
URJA_MAX_CONCURRENCY=4

# Cache freshness, in seconds. Data older than the TTL is reloaded; if the portal is down it may be
# served for up to URJA_CACHE_MAX_STALE_SECONDS past the TTL and is flagged X-Cache: STALE.
URJA_CACHE_TTL_SECONDS=300
URJA_CACHE_TTL_CONSUMPTION_SECONDS=60
URJA_CACHE_MAX_STALE_SECONDS=3600
# Coordinates cost one portal request per meter and never change in practice.
URJA_CACHE_TTL_GEO_SECONDS=3600

# Browser origins allowed to call this API (GET only), comma separated. The web/ dev server by default.
URJA_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# debug | info | warning | error
URJA_LOG_LEVEL=info
