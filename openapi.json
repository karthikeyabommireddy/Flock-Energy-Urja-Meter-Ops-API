{
  "openapi": "3.1.0",
  "info": {
    "title": "Flock Energy \u2014 Urja Meter Ops API",
    "description": "Clean REST API proxy layer over the legacy Urja Meter Ops portal. Handles authentication, session management, and HTML/JSON normalisation so downstream clients never talk to the legacy portal directly.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Force a fresh login against the portal. Not required before other calls.",
        "operationId": "login_api_v1_auth_login_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "List Meters",
        "operationId": "list_meters_api_v1_meters_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MeterSummary"
                  },
                  "type": "array",
                  "title": "Response List Meters Api V1 Meters Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meter_id}": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Get Meter",
        "operationId": "get_meter_api_v1_meters__meter_id__get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meter_id}/consumption": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Get Meter Consumption",
        "operationId": "get_meter_consumption_api_v1_meters__meter_id__consumption_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionHistory"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hierarchy": {
      "get": {
        "tags": [
          "hierarchy"
        ],
        "summary": "Get Hierarchy",
        "description": "Optional extension \u2014 the organised network tree.",
        "operationId": "get_hierarchy_api_v1_hierarchy_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/HierarchyNode"
                  },
                  "type": "array",
                  "title": "Response Get Hierarchy Api V1 Hierarchy Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConsumptionHistory": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/ConsumptionRecord"
            },
            "type": "array",
            "title": "Records"
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "records"
        ],
        "title": "ConsumptionHistory",
        "description": "GET /api/v1/meters/{id}/consumption."
      },
      "ConsumptionRecord": {
        "properties": {
          "period": {
            "type": "string",
            "title": "Period",
            "description": "ISO 8601 date/timestamp, or the raw label if unparseable"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value",
            "description": "Consumption value, normalised to float. null if unparseable"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "type": "object",
        "required": [
          "period",
          "value"
        ],
        "title": "ConsumptionRecord",
        "description": "One data point in a consumption history."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HierarchyNode": {
        "properties": {
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "node_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Node Type"
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/HierarchyNode"
            },
            "type": "array",
            "title": "Children"
          }
        },
        "type": "object",
        "required": [
          "node_id",
          "name"
        ],
        "title": "HierarchyNode",
        "description": "A node in the network hierarchy tree \u2014 GET /api/v1/hierarchy (optional extension)."
      },
      "LoginResult": {
        "properties": {
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "authenticated",
          "detail"
        ],
        "title": "LoginResult",
        "description": "POST /api/v1/auth/login."
      },
      "MeterDetail": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id"
          },
          "serial_number": {
            "type": "string",
            "title": "Serial Number"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "installed_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Installed Date",
            "description": "ISO 8601 date if the portal provided a parseable one"
          },
          "raw_fields": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Raw Fields",
            "description": "Any additional fields the portal exposed that don't map to a named field above. Kept rather than discarded, since the portal's exact field set was not confirmed against a live session \u2014 see PROTOCOL.md."
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "serial_number",
          "status"
        ],
        "title": "MeterDetail",
        "description": "A single meter's full detail \u2014 GET /api/v1/meters/{id}."
      },
      "MeterSummary": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id"
          },
          "serial_number": {
            "type": "string",
            "title": "Serial Number"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "e.g. ACTIVE, INACTIVE, FAULT, UNKNOWN"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "serial_number",
          "status"
        ],
        "title": "MeterSummary",
        "description": "One row of the meter listing \u2014 GET /api/v1/meters."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}