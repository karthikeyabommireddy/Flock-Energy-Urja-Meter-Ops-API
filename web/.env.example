# Copy to web/.env.local if the API is not on the default address (.env.local is git-ignored).
# The API must allow this app's origin: URJA_CORS_ALLOW_ORIGINS (default http://localhost:5173 and http://127.0.0.1:5173).
# Leave the value empty (VITE_API_BASE_URL=) to call the same origin the page is served from.
VITE_API_BASE_URL=http://127.0.0.1:8000
